# --------------------------------------------------------------------------
# Wings Mediaa — environment variables
#
# Copy this to `.env.local` for local dev (it's gitignored). Set the
# production values on Vercel via the project's Environment Variables UI.
# --------------------------------------------------------------------------

# Canonical public URL. Used by sitemap, robots, OG images, JSON-LD.
# Defaults to https://wingsmediaa.com if unset.
NEXT_PUBLIC_SITE_URL=https://wingsmediaa.com

# --------------------------------------------------------------------------
# Sanity Studio — uncomment and fill in once `npx sanity init` is run.
# Until then the site reads from lib/content/* (the hardcoded v1 fallback).
# --------------------------------------------------------------------------
# NEXT_PUBLIC_SANITY_PROJECT_ID=xxxxxxxx
# NEXT_PUBLIC_SANITY_DATASET=production
# SANITY_API_TOKEN=

# --------------------------------------------------------------------------
# Resend (contact form submissions). Currently the form simulates submission
# locally — wire this when the production /api/contact route is added.
# --------------------------------------------------------------------------
# RESEND_API_KEY=
# CONTACT_DESTINATION_EMAIL=hello@wingsmediaa.com

# --------------------------------------------------------------------------
# Analytics — Phase G ships none by default. Uncomment when ready.
# --------------------------------------------------------------------------
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=wingsmediaa.com
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
